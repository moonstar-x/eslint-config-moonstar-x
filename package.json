{
  "name": "@moonstar-x/eslint-config",
  "version": "2.0.0",
  "description": "Strict, composable ESLint 10 flat configurations for JavaScript, TypeScript, Node.js and React projects.",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest",
    "test:watch": "npm test -- --watch",
    "prebuild": "npm run clean",
    "prepack": "npm run build"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "typescript",
    "react",
    "node",
    "strict",
    "stylistic"
  ],
  "license": "MIT",
  "author": "moonstar-x <christian.lopez99@outlook.com>",
  "homepage": "https://github.com/moonstar-x-libs/eslint-config-moonstar-x#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonstar-x-libs/eslint-config-moonstar-x.git"
  },
  "bugs": {
    "url": "https://github.com/moonstar-x-libs/eslint-config-moonstar-x/issues"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@moonstar-x/tsconfig": "^1.0.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^30.5.1",
    "jiti": "^2.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "type-fest": "^4.41.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
